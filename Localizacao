public class Localizacao {
    private String identificadorLocalizacao;
    private float latitude;
    private float longitude;
    private String endereco;

    public String getIdentificadorLocalizacao() {
        return identificadorLocalizacao;
    }

    public void setIdentificadorLocalizacao(String identificadorLocalizacao) {
        this.identificadorLocalizacao = identificadorLocalizacao;
    }

    public float getLatitude() {
        return latitude;
    }

    public void setLatitude(float latitude) {
        this.latitude = latitude;
    }

    public float getLongitude() {
        return longitude;
    }

    public void setLongitude(float longitude) {
        this.longitude = longitude;
    }

    public String getEndereco() {
        return endereco;
    }

    public void setEndereco(String endereco) {
        this.endereco = endereco;
    }
    
    
}
